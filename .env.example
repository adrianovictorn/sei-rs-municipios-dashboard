# Copie este arquivo para .env e ajuste os valores antes de subir a stack.

POSTGRES_DB=seimunicipios
POSTGRES_USER=seimunicipios
POSTGRES_PASSWORD=troque-esta-senha

# Porta exposta no host para acessar a aplicação (nginx + frontend)
HTTP_PORT=80

# Origem liberada no CORS do backend (endereço público usado pelo navegador)
CORS_ALLOWED_ORIGINS=http://localhost
